# ═══════════════════════════════════════════════════════════
# Server-side only. Set these in the Vercel dashboard under
# Project -> Settings -> Environment Variables.
# Never commit real values — .env is already gitignored.
# ═══════════════════════════════════════════════════════════

# Project URL, from Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role key, same page. Bypasses RLS — server-side only.
# NEVER expose this in index.html or any client-side file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bearer token for GET /api/inquiries. Any long random string.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=replace-me

# ── GitHub Actions secrets (repo -> Settings -> Secrets -> Actions) ──
# These are NOT read from this file; they are listed here for reference.
# SUPABASE_ACCESS_TOKEN     - https://supabase.com/dashboard/account/tokens
# SUPABASE_PROJECT_REF      - the <ref> in https://<ref>.supabase.co
# SUPABASE_DB_PASSWORD      - the database password chosen at project creation
